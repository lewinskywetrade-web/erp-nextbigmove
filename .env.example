# Application
NODE_ENV=development
PORT=3001
TZ=Asia/Manila
# all = API and workers in one process (development/backward-compatible)
# Production Compose overrides this per service with api or worker.
PROCESS_ROLE=all
LOG_DEBUG_ENABLED=true

# Database
DATABASE_URL="postgresql://erp_user:dev_password@localhost:5433/erp_analytics?schema=public"
DATABASE_CONNECTION_LIMIT=6
DATABASE_POOL_TIMEOUT_SECONDS=10
# Production Compose applies these independently to the API and worker.
API_DATABASE_CONNECTION_LIMIT=6
API_DATABASE_POOL_TIMEOUT_SECONDS=10
WORKER_DATABASE_CONNECTION_LIMIT=3
WORKER_DATABASE_POOL_TIMEOUT_SECONDS=20

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-64-chars-change-in-production-use-strong-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-64-chars-change-in-production-use-strong-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# CORS Origins
CORS_ORIGIN_WEB=http://localhost:3000
CORS_ORIGIN_ADMIN=http://localhost:3002
CORS_ORIGIN_ADVERTISING=http://localhost:3003

# Next.js Web App
NEXT_PUBLIC_TIMEZONE=Asia/Manila
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Next.js Admin App
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001/api/v1

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Encryption (per-tenant keys stored in DB)
MASTER_ENCRYPTION_KEY=your-master-encryption-key-32-bytes-hex-change-in-production

# Workflows
# Set to true to process workflow executions inline (useful if Redis/Bull queue is unavailable in development)
WORKFLOW_PROCESS_INLINE=true

# Object Storage (S3-compatible: MinIO locally, Spaces/S3 in production)
OBJECT_STORAGE_PROVIDER=s3-compatible
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=erp-local-media
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=900
OBJECT_STORAGE_PAYMENT_PROOF_MAX_FILE_MB=8
OBJECT_STORAGE_UNDELIVERABLE_PROOF_MAX_FILE_MB=30
OBJECT_STORAGE_PACKING_PROOF_MAX_FILE_MB=30
OBJECT_STORAGE_STOX_APK_MAX_FILE_MB=150
WMS_STOX_PACKING_PROOF_REQUIRED=false

# Queue tuning
PANCAKE_WEBHOOK_PROCESSOR_CONCURRENCY=2
PANCAKE_AUTO_CANCEL_PROCESSOR_CONCURRENCY=1
PANCAKE_REPORTS_HYDRATE_PROCESSOR_CONCURRENCY=1
PANCAKE_RECONCILE_PROCESSOR_CONCURRENCY=1
PANCAKE_WEBHOOK_RECONCILE_DELAY_MS=10000
PANCAKE_WEBHOOK_RECONCILE_MIN_DELAY_MS=10000
PANCAKE_WEBHOOK_RECONCILE_MAX_DELAY_MS=10000
# Keep automatic webhook reconciliation incremental. Enable full resets only for a controlled repair window.
PANCAKE_WEBHOOK_ALLOW_AUTOMATIC_FULL_RESET=false
PANCAKE_RECONCILE_QUEUE_ATTEMPTS=3
PANCAKE_RECONCILE_QUEUE_BACKOFF_MS=4000
PANCAKE_RECONCILE_QUEUE_TIMEOUT_MS=300000
CONFIRMATION_UPDATE_QUEUE_CONCURRENCY=4
WMS_PICKING_HANDOFF_QUEUE_CONCURRENCY=4
WMS_PICKING_HANDOFF_QUEUE_ATTEMPTS=4
WMS_PICKING_HANDOFF_QUEUE_BACKOFF_MS=3000
WMS_PICKING_HANDOFF_QUEUE_TIMEOUT_MS=45000
WMS_PACKING_POST_COMPLETE_QUEUE_CONCURRENCY=2
WMS_PACKING_POST_COMPLETE_QUEUE_ATTEMPTS=4
WMS_PACKING_POST_COMPLETE_QUEUE_BACKOFF_MS=3000
WMS_PACKING_POST_COMPLETE_QUEUE_TIMEOUT_MS=60000

# WMS feature rollout
WMS_BASKET_DEMAND_PICKING_ENABLED=true
WMS_STOX_LEGACY_RESERVED_ENABLED=false

# Creative AI (Claudebox gateway integration)
# The API rejects every Creative AI endpoint and the worker does not register
# the analysis processor unless AI_AGENT_ENABLED is exactly true. Locally, start
# Claudebox on 127.0.0.1:3100 with CREATIVE_AI_WORKSPACE_ROOT mounted at
# /workspace. In production the gateway is the `claudebox` Compose service
# (profile "ai"); see CREATIVE_AI_PRODUCTION_ROLLOUT.md. Keep both secrets
# backend-only.
NEXT_PUBLIC_AI_AGENT_ENABLED=false
AI_AGENT_ENABLED=false
# Production only: start the Claudebox service with the rest of the stack.
# COMPOSE_PROFILES=ai
CLAUDEBOX_WS_URL=ws://127.0.0.1:3100/ws
# Private HTTP control plane used by the API for provider status and sign-in.
CLAUDEBOX_HTTP_URL=http://127.0.0.1:3100
CLAUDEBOX_API_KEY=
AI_AGENT_SIGNING_SECRET=
# Claudebox stream-json includes image tool payloads. Keep enough headroom for
# the sampled video frames while retaining a bounded per-run safety limit.
CLAUDEBOX_MAX_OUTPUT_BYTES=67108864
CREATIVE_AI_WORKSPACE_ROOT=/absolute/path/to/ERP-System/apps/api/tmp/creative-ai
CREATIVE_AI_UPLOAD_TMP_DIR=/absolute/path/to/ERP-System/apps/api/tmp/creative-ai-uploads
# Upload ceiling for both video and static-image analyses.
CREATIVE_AI_MAX_VIDEO_MB=250
CREATIVE_AI_MAX_VIDEO_SECONDS=600
CREATIVE_AI_HOOK_FRAME_LIMIT=6
CREATIVE_AI_TIMELINE_FRAME_LIMIT=12
CREATIVE_AI_FFMPEG_BIN=ffmpeg
CREATIVE_AI_FFPROBE_BIN=ffprobe
# Optional: the Python openai-whisper CLI. When blank, the registered script
# is used and the result explicitly reports that audio was not transcribed.
# Audio transcription. Either a local Whisper CLI (CREATIVE_AI_WHISPER_BIN) or
# the Whisper service from apps/whisper (CREATIVE_AI_WHISPER_URL); the service
# wins when both are set. Blank both to analyse without sound.
CREATIVE_AI_WHISPER_BIN=
CREATIVE_AI_WHISPER_URL=
CREATIVE_AI_WHISPER_MODEL=small
# Pin the spoken language (tl = Tagalog) or leave blank to auto-detect.
CREATIVE_AI_WHISPER_LANGUAGE=
# Scene sampling: cut sensitivity 0..1, scene and grid-frame caps, and the
# byte budget for what is pushed to the gateway (its socket cap is 12 MB).
CREATIVE_AI_SCENE_THRESHOLD=0.3
CREATIVE_AI_MAX_SCENES=40
CREATIVE_AI_MAX_GRID_FRAMES=90
CREATIVE_AI_PUSH_BUDGET_BYTES=8000000
CREATIVE_AI_TRANSCRIPTION_TIMEOUT_MS=1200000

# Meta draft automation. The creative's source file is copied into object
# storage at its first analysis and held until the draft worker hands it to
# Meta; a file nobody sends is swept after this many days. The draft queue runs
# in the worker role with its own concurrency and a per-minute rate limit so a
# burst of sends never throttles the ad account or delays other jobs.
CREATIVE_MEDIA_GRACE_DAYS=30
CREATIVE_META_DRAFT_CONCURRENCY=2
CREATIVE_META_DRAFT_RATE_PER_MINUTE=10
CREATIVE_AI_MODEL=sonnet
CREATIVE_AI_MAX_TURNS=12
CREATIVE_AI_MAX_BUDGET_USD=1
# Outer bound the ERP waits for one model call. Per-tenant limits come from
# Settings -> AI (Maximum time per run); this must be >= the largest of those.
CREATIVE_AI_RUN_TIMEOUT_MS=3900000
# Set to true only when the API/worker and the gateway mount the same volume
# (single-host deployments). Otherwise the prepared frames are pushed to the
# gateway over its WebSocket, which is what a separate gateway host needs.
CREATIVE_AI_SHARED_WORKSPACE=false
CREATIVE_AI_QUEUE_CONCURRENCY=1
CREATIVE_AI_QUEUE_ATTEMPTS=2
CREATIVE_AI_QUEUE_BACKOFF_MS=3000
# The uploaded video is deleted once frames exist (its SHA-256 stays on the run).
CREATIVE_AI_RETAIN_SOURCE_VIDEO=false
# Frames and context files are purged this many days after a run finishes.
CREATIVE_AI_WORKSPACE_RETENTION_DAYS=14
# Extra time past the job timeout before a silent run is closed as failed.
CREATIVE_AI_STALE_RUN_GRACE_MS=120000
