model Creative {
  id                  String                    @id @default(uuid()) @db.Uuid
  tenantId            String                    @db.Uuid
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeConfigId       String                    @db.Uuid
  storeConfig         CreativeStoreConfig       @relation(fields: [storeConfigId], references: [id], onDelete: Restrict)
  code                String
  codeNumber          Int
  kind                CreativeKind
  title               String
  format              String?
  hookType            String?
  /// The big idea in the creative's own words ("nanay ng picky eater, guilt
  /// angle"). hookType is the coarse category; this is the free-text one the
  /// Creative Insights analysis learns from.
  angle               String?
  /// Registry code of the winner this creative was remixed from. Set at
  /// enrolment, never edited — it is how the lineage report answers whether
  /// refreshes beat their parents.
  remixOfCode         String?
  /// The spoken / on-screen script of the video itself. The ad copy is not
  /// mirrored here — it already lives on the Facebook page post.
  script              String?
  notes               String?
  mediaUrl            String?
  /// Google Drive share link to the source file. The Facebook post link above
  /// is the creative as it ran; this is the file it was made from, and the
  /// second place the analysis looks when fetching media by link.
  driveUrl            String?
  // The item this creative advertises, chosen at enrollment. customId is the
  // partner's own Pancake identifier and becomes the ad-name mapping segment;
  // the name is a display snapshot so the registry stays readable if the POS
  // product is renamed or removed.
  posVariationId      String?
  posCustomId         String?
  posProductName      String?
  createdById         String                    @db.Uuid
  createdBy           User                      @relation("CreativeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revisionState       CreativeRevisionState     @default(NONE)
  revisionRequestedAt DateTime?
  revisionResolvedAt  DateTime?
  performanceStatus   CreativePerformanceStatus @default(DRAFT)
  submittedAt         DateTime?
  approvedAt          DateTime?
  metaAccountId       String?
  metaAdId            String?
  metaAdNameSnapshot  String?
  metaLinkSource      CreativeMetaLinkSource?
  metaLinkedAt        DateTime?
  metaLinkedById      String?                   @db.Uuid
  metaLinkedBy        User?                     @relation("CreativeMetaLinkedBy", fields: [metaLinkedById], references: [id], onDelete: SetNull)

  // Cached cover image resolved from the Facebook post's og:image. The CDN URL
  // Facebook hands out expires in days, so the bytes are copied into object
  // storage once and served from there instead of being hot-linked.
  thumbnailAssetId    String?     @db.Uuid
  thumbnailAsset      MediaAsset? @relation("CreativeThumbnailAsset", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  thumbnailSourceUrl  String?
  thumbnailCapturedAt DateTime?
  thumbnailIsVideo    Boolean     @default(false)

  // The file itself, copied into object storage at its first analysis and
  // held until the draft worker has handed it to Meta. Frames, transcript and
  // the analysis outlive it; only the bytes are released. A file nobody sends
  // is swept once mediaExpiresAt passes.
  sourceAssetId       String?     @db.Uuid
  sourceAsset         MediaAsset? @relation("CreativeSourceAsset", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  mediaCapturedAt     DateTime?
  mediaReleasedAt     DateTime?
  mediaExpiresAt      DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  aliases           CreativeAlias[]
  statusEvents      CreativeStatusEvent[]
  metaAdLinks       CreativeMetaAdLink[]
  reviewComments    CreativeReviewComment[]
  strategyEntries   CreativeStrategyEntry[]
  aiRuns            CreativeAiRun[]
  knowledgeEntries  CreativeKnowledgeEntry[]
  enrollmentReviews CreativeEnrollmentReview[]
  metaDrafts        CreativeMetaDraft[]

  @@unique([tenantId, code])
  @@unique([storeConfigId, codeNumber])
  @@unique([tenantId, metaAccountId, metaAdId])
  @@unique([tenantId, metaAdId])
  @@index([tenantId, createdAt])
  @@index([tenantId, createdById])
  @@index([tenantId, storeConfigId])
  @@index([tenantId, revisionState])
  @@index([tenantId, performanceStatus])
  @@index([tenantId, metaAdId])
  @@index([tenantId, mediaExpiresAt])
  @@map("creatives")
}

model CreativeMetaAdLink {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @db.Uuid
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creativeId     String                 @db.Uuid
  creative       Creative               @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  accountId      String
  adId           String
  adNameSnapshot String
  source         CreativeMetaLinkSource
  linkedById     String?                @db.Uuid
  linkedAt       DateTime               @default(now())
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([tenantId, accountId, adId])
  @@unique([tenantId, adId])
  @@index([tenantId, creativeId])
  @@index([creativeId, linkedAt])
  @@map("creative_meta_ad_links")
}

model CreativeAlias {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creativeId      String   @db.Uuid
  creative        Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String
  createdById     String?  @db.Uuid
  createdBy       User?    @relation("CreativeAliasCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@unique([tenantId, normalizedAlias])
  @@index([creativeId])
  @@index([tenantId, createdAt])
  @@map("creative_aliases")
}

/// The tenant's Anthropic key, set by the main admin in Settings → AI and
/// encrypted with the tenant's own key — same scheme as integration
/// credentials. Only the last four characters ever leave the server again.
model AiSetting {
  tenantId        String   @id @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encryptedApiKey String
  keyLast4        String
  updatedById     String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ai_settings")
}

/// One saved Ads Insight analysis — the LLM's winners-vs-losers read for a
/// period. Persisted so this month's read can be compared with last month's,
/// and so a ₱-costing model call is never repeated just to re-open a page.
model CreativeInsightRun {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date
  model        String
  answer       String
  /// What the model was shown, compressed: codes + counts, for audit.
  inputSummary Json?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("creative_insight_runs")
}

/// Strategy Log — one dated line per decision the creative made, and the
/// outcome written back once it has played out. This is what turns "the
/// numbers moved" into "the numbers moved when we changed this", and it is the
/// memory Creative Insights reads so its analysis knows what was actually
/// tried instead of inferring it from metrics alone.
model CreativeStrategyEntry {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @db.Uuid
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The day the change TOOK EFFECT, not the day it was typed — a change
  /// logged late still has to line up with the week its numbers moved.
  date            DateTime               @db.Date
  title           String
  description     String?
  /// Free text, not an enum: the fixed list covers the usual moves, and a
  /// typed-in type is kept as-is so the vocabulary can grow without a migration.
  tag             String                 @default("OTHER")
  /// Written after the fact. Half the value of the log lives here — an entry
  /// with no result says what was tried, one with a result says what works.
  result          String?
  resultUpdatedAt DateTime?
  /// AUTO_ENROLMENT rows are receipts the registry wrote when a creative was
  /// enrolled, so a new video never depends on someone remembering to log it.
  source          CreativeStrategySource @default(MANUAL)
  /// Set on the auto rows, so an entry can be traced back to the creative it
  /// records. Nulled rather than deleted if that creative ever goes away — the
  /// decision still happened.
  creativeId      String?                @db.Uuid
  creative        Creative?              @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  createdById     String                 @db.Uuid
  createdBy       User                   @relation("CreativeStrategyAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([tenantId, date])
  @@index([tenantId, createdById, date])
  @@index([creativeId])
  @@map("creative_strategy_entries")
}

enum CreativeStrategySource {
  MANUAL
  AUTO_ENROLMENT
}

model CreativeStatusEvent {
  id         String                  @id @default(uuid()) @db.Uuid
  tenantId   String                  @db.Uuid
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creativeId String                  @db.Uuid
  creative   Creative                @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  dimension  CreativeStatusDimension
  fromStatus String
  toStatus   String
  actorId    String?                 @db.Uuid
  actor      User?                   @relation("CreativeStatusEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  reason     String?
  createdAt  DateTime                @default(now())

  @@index([tenantId, creativeId, createdAt])
  @@index([tenantId, dimension, createdAt])
  @@map("creative_status_events")
}

model CreativeReviewComment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creativeId String   @db.Uuid
  creative   Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  authorId   String   @db.Uuid
  author     User     @relation("CreativeReviewCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  message    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, creativeId, createdAt])
  @@index([authorId])
  @@map("creative_review_comments")
}

enum CreativeAiRunStatus {
  QUEUED
  PREPROCESSING
  CONTEXT_BUILDING
  ANALYZING
  COMPLETED
  FAILED
  CANCELLED
}

enum CreativeAiSourceType {
  LOCAL_UPLOAD
  GOOGLE_DRIVE
  FACEBOOK_POST
  /// The file held in object storage since enrollment.
  STORED_SOURCE
}

enum CreativeAiProvider {
  CLAUDE
  CODEX
}

enum CreativeAiEffort {
  LOW
  MEDIUM
  HIGH
  XHIGH
  MAX
}

/// Tenant defaults for Creative AI. Provider credentials remain in the
/// isolated AI gateway; this table contains policy only, never secrets.
model CreativeAiPolicy {
  tenantId          String             @id @db.Uuid
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultProvider   CreativeAiProvider @default(CLAUDE)
  claudeModel       String             @default("sonnet")
  codexModel        String             @default("gpt-5.6-terra")
  defaultEffort     CreativeAiEffort   @default(MEDIUM)
  maxTurns          Int                @default(12)
  /// Retained for historical runs. Runs are limited by turns and wall-clock
  /// time, not by cost: tenants pay a flat subscription, so a dollar cap only
  /// ever cut analyses short without saving anything.
  maxBudgetUsd      Decimal            @default(1) @db.Decimal(10, 2)
  /// Wall-clock ceiling for one analysis, in minutes.
  maxRunMinutes     Int                @default(15)
  allowRunOverrides Boolean            @default(true)

  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("CreativeAiPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("creative_ai_policies")
}

/// A tenant-scoped, immutable request to analyze one registered creative.
/// Local uploads are persisted only as a workspace-relative path; the API
/// never returns that path to clients. GOOGLE_DRIVE is reserved for the next
/// ingestion adapter and keeps the analysis pipeline storage-agnostic.
model CreativeAiRun {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @db.Uuid
  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creativeId        String                    @db.Uuid
  creative          Creative                  @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  requestedById     String                    @db.Uuid
  requestedBy       User                      @relation("CreativeAiRunRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  status            CreativeAiRunStatus       @default(QUEUED)
  sourceType        CreativeAiSourceType      @default(LOCAL_UPLOAD)
  provider          CreativeAiProvider        @default(CLAUDE)
  model             String                    @default("sonnet")
  effort            CreativeAiEffort          @default(MEDIUM)
  settingsSnapshot  Json?
  sourceFileName    String?
  sourceContentType String?
  sourceByteSize    Int?
  sourcePath        String?
  question          String?
  dateStart         DateTime                  @db.Date
  dateEnd           DateTime                  @db.Date
  progress          Int                       @default(0)
  stage             String                    @default("Queued")
  queueJobId        String?
  /// Which prompt judged this run, and why. Recorded because the two answer
  /// different questions: a reader must know whether they are looking at a
  /// performance verdict or a craft review.
  analysisMode      String?
  analysisModeNote  String?
  /// The saved prompt version this run used. Null means the built-in default.
  promptTemplateId  String?                   @db.Uuid
  promptTemplate    CreativeAiPromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  mediaHash         String?                   @db.VarChar(64)
  mediaManifest     Json?
  metricsSnapshot   Json?
  analysisResult    Json?
  responseText      String?
  claudeSessionId   String?
  warnings          String[]                  @default([])
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  knowledgeEntries  CreativeKnowledgeEntry[]
  enrollmentReviews CreativeEnrollmentReview[] @relation("CreativeEnrollmentReviewRun")
  frames            CreativeAiRunFrame[]

  @@index([tenantId, requestedById, createdAt])
  @@index([tenantId, creativeId, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("creative_ai_runs")
}

/// One stored thumbnail per detected scene of an analysed video, so the
/// storyboard and the knowledge base can show how a creative is built long
/// after the run workspace has been swept.
model CreativeAiRunFrame {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId            String        @db.Uuid
  run              CreativeAiRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sceneIndex       Int
  /// Seconds from the start; null for a static creative's single frame.
  timestampSeconds Decimal?      @db.Decimal(10, 3)
  endSeconds       Decimal?      @db.Decimal(10, 3)
  assetId          String        @db.Uuid
  asset            MediaAsset    @relation("CreativeAiRunFrameAsset", fields: [assetId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())

  @@unique([runId, sceneIndex])
  @@index([tenantId, runId])
  @@map("creative_ai_run_frames")
}

/// Which of the two analysis prompts a template is for. A creative with real
/// Meta delivery gets the running analyst; one without gets the new-creative
/// reviewer. The choice is made from the creative's own data, never by hand.
enum CreativeAiPromptKind {
  RUNNING_ANALYST
  NEW_REVIEWER
}

/// One saved version of an analysis prompt.
///
/// Prompts are versioned the way code is: every edit is a new row, earlier
/// rows stay, and each run records which version judged it. That is what lets
/// someone read an old analysis and know exactly what the model was told, and
/// roll back a wording change that turned out to hurt. Only one version per
/// kind is active; none active means the built-in default runs.
///
/// The body is the advertiser's text. It may use {{VARIABLES}} the system
/// fills at run time (store, product, the knowledge base, the library). The
/// output contract stays in code, so a wording edit can never break what the
/// ERP parses.
model CreativeAiPromptTemplate {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @db.Uuid
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        CreativeAiPromptKind
  version     Int
  body        String
  /// What changed and why, like a commit message.
  note        String?
  isActive    Boolean              @default(true)
  createdById String?              @db.Uuid
  createdBy   User?                @relation("CreativeAiPromptTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())

  runs CreativeAiRun[]

  @@unique([tenantId, kind, version])
  @@index([tenantId, kind, isActive])
  @@map("creative_ai_prompt_templates")
}

/// Which creatives a reference document applies to.
enum CreativeAiDocumentScope {
  TENANT
  STORE
  PRODUCT
}

enum CreativeAiDocumentStatus {
  READY
  FAILED
  UNSUPPORTED
}

/// A document the advertiser uploaded for the analysis to consult: brand
/// rules, claim sheets, agency playbooks. Text is extracted once at upload
/// and injected into both prompts as reference material. Never evidence: a
/// document has no outcome, so it stays out of the knowledge entries.
model CreativeAiReferenceDocument {
  id            String                   @id @default(uuid()) @db.Uuid
  tenantId      String                   @db.Uuid
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scope         CreativeAiDocumentScope  @default(TENANT)
  storeConfigId String?                  @db.Uuid
  storeConfig   CreativeStoreConfig?     @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
  /// Matches Creative.posProductName for PRODUCT scope.
  productName   String?
  title         String
  fileName      String
  contentType   String
  byteSize      Int
  sha256        String                   @db.VarChar(64)
  /// Where the original bytes live, so the text can be re-extracted later.
  objectKey     String?
  /// The extracted text the prompt receives, capped at upload.
  text          String
  characterCount Int
  /// Roughly characters / 4; what the document adds to every analysis.
  tokenEstimate Int
  status        CreativeAiDocumentStatus @default(READY)
  statusNote    String?
  /// Increments when the same title is re-uploaded, so runs can cite exactly what they read.
  version       Int                      @default(1)
  active        Boolean                  @default(true)
  uploadedById  String?                  @db.Uuid
  uploadedBy    User?                    @relation("CreativeAiReferenceDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([tenantId, active, scope])
  @@index([tenantId, storeConfigId])
  @@map("creative_ai_reference_documents")
}

/// Target KPIs for one store's creatives.
///
/// This is what "winning" means for the store, written down once and read by
/// every analysis of its creatives: the running-creative prompt is handed these
/// numbers as variables, so nobody retypes them per product or per run. Rates
/// are stored as percentages (25 means 25%). A null means the store has not
/// decided that target yet, and the prompt is told so rather than given a
/// borrowed number.
model CreativeStoreTarget {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeConfigId String              @unique @db.Uuid
  storeConfig   CreativeStoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)

  /// Diagnostics: what a healthy creative for this store looks like.
  hookRatePct Decimal? @db.Decimal(6, 2)
  holdRatePct Decimal? @db.Decimal(6, 2)
  ctrPct      Decimal? @db.Decimal(6, 2)

  /// Verdict bands for cost per purchase. The break-even is where an order
  /// stops making money, derived from the store's own reconciled economics;
  /// the target is the ambition below it; scale and kill are the lines that
  /// decide where budget goes.
  breakevenCpp Decimal? @db.Decimal(12, 2)
  cpp          Decimal? @db.Decimal(12, 2)
  scaleCpp     Decimal? @db.Decimal(12, 2)
  killCpp      Decimal? @db.Decimal(12, 2)

  /// The same three bands for spend as a share of collected revenue.
  arPct      Decimal? @db.Decimal(6, 2)
  scaleArPct Decimal? @db.Decimal(6, 2)
  killArPct  Decimal? @db.Decimal(6, 2)

  /// Audience-quality ceilings under cash on delivery.
  maxCancellationPct Decimal? @db.Decimal(6, 2)
  maxRtsPct          Decimal? @db.Decimal(6, 2)

  note        String?
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("CreativeStoreTargetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("creative_store_targets")
}

/// The tenant's fallback creative targets.
///
/// A tenant can have well over a hundred stores, and filling the same six
/// numbers into each one by hand is not a decision, it is data entry. These
/// are inherited by any store that has not set its own, and the prompt is
/// told the figures are the tenant default so nobody mistakes them for a
/// judgement made about that store.
model CreativeAiTargetDefault {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  breakevenCpp Decimal? @db.Decimal(12, 2)
  cpp          Decimal? @db.Decimal(12, 2)
  scaleCpp     Decimal? @db.Decimal(12, 2)
  killCpp      Decimal? @db.Decimal(12, 2)

  arPct      Decimal? @db.Decimal(6, 2)
  scaleArPct Decimal? @db.Decimal(6, 2)
  killArPct  Decimal? @db.Decimal(6, 2)

  maxCancellationPct Decimal? @db.Decimal(6, 2)
  maxRtsPct          Decimal? @db.Decimal(6, 2)

  hookRatePct Decimal? @db.Decimal(6, 2)
  holdRatePct Decimal? @db.Decimal(6, 2)
  ctrPct      Decimal? @db.Decimal(6, 2)

  note        String?
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("CreativeAiTargetDefaultUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("creative_ai_target_defaults")
}

/// Why a creative entered the knowledge base. A knowledge entry is only ever
/// created from a COMPLETED analysis, so the structural record always exists;
/// this says what outcome the structure is evidence *for*.
enum CreativeKnowledgeLabel {
  WINNER
  LOSER
  INCONCLUSIVE
}

/// How the label was decided. Automatic labels come from reconciled spend and
/// contribution; a human can override, and the override is never recomputed.
enum CreativeKnowledgeLabelSource {
  AUTOMATIC
  MANUAL
}

/// How confidently the label can be attributed to THIS creative rather than to
/// whatever else ran beside it. Revenue in the ERP attributes to a Meta
/// campaign, so a creative that shared its campaign carries a weaker claim on
/// the result. The knowledge base records this instead of hiding it: SOLE means
/// the creative ran alone in its campaign and the outcome is unambiguously its
/// own; SHARED means the campaign carried other creatives too.
enum CreativeKnowledgeAttribution {
  SOLE
  SHARED
  UNKNOWN
}

/// One analyzed creative promoted into a store's knowledge base.
///
/// This is the corpus the enrollment gate reasons over. Scope is always
/// (tenant, store): a fragrance store and a supplement store must never inform
/// each other's decisions, and store is the narrowest scope the advertiser
/// actually curates. The row keeps a snapshot of the structural analysis rather
/// than pointing at the run alone, so re-running or purging an analysis cannot
/// silently change what the gate already learned from.
model CreativeKnowledgeEntry {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeConfigId String              @db.Uuid
  storeConfig   CreativeStoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
  creativeId    String              @db.Uuid
  creative      Creative            @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  /// The analysis this entry was built from. Kept for provenance; the payload
  /// below is the copy the gate reads.
  runId         String?             @db.Uuid
  run           CreativeAiRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  label          CreativeKnowledgeLabel
  labelSource    CreativeKnowledgeLabelSource @default(AUTOMATIC)
  attribution    CreativeKnowledgeAttribution @default(UNKNOWN)
  /// Free-text reason a human gave when overriding, or the rule that fired.
  labelRationale String?

  /// The store's niche when this entry was captured. Kept on the row because a
  /// store can be relabelled later and the entry should remember the context it
  /// was judged in.
  nicheSnapshot String

  /// Frozen copy of the structural analysis: the six sections with their
  /// timestamped findings. This is what makes the knowledge base a craft
  /// library rather than a metrics table.
  structure Json
  /// Frozen copy of the economics behind the label (spend, delivered orders,
  /// net contribution, rates) so a reader can audit why it was called.
  metrics   Json?
  /// Short retrieval digest written at promotion time: the construction
  /// pattern in a few lines. Keeps gate prompts small when a store has many
  /// entries.
  digest    String?

  promotedById String?  @db.Uuid
  promotedBy   User?    @relation("CreativeKnowledgePromotedBy", fields: [promotedById], references: [id], onDelete: SetNull)
  promotedAt   DateTime @default(now())
  /// Soft-retire an entry without deleting its history. Retired entries stop
  /// informing the gate.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviews CreativeEnrollmentReview[]

  /// One entry per creative: promoting twice updates in place.
  @@unique([tenantId, creativeId])
  @@index([tenantId, storeConfigId, active, label])
  @@index([tenantId, storeConfigId, promotedAt])
  @@map("creative_knowledge_entries")
}

enum CreativeEnrollmentReviewStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// What the gate concluded. REVISE exists because rejecting a fixable creative
/// wastes the work that made it; most real feedback is "change these two things".
enum CreativeEnrollmentDecision {
  APPROVE
  REVISE
  REJECT
}

/// A human's ruling on the gate's recommendation. The gate never publishes on
/// its own: this field is what authorizes anything downstream, and it starts
/// PENDING for every review.
enum CreativeEnrollmentReviewOutcome {
  PENDING
  ACCEPTED
  OVERRIDDEN
}

/// One pass of the enrollment gate over a newly enrolled creative.
///
/// The gate compares the creative's structure against its own store's knowledge
/// entries and recommends approve, revise or reject. It is advisory by
/// construction: `outcome` stays PENDING until a person rules, and nothing may
/// publish to Meta on the recommendation alone. `shadow` marks runs made while
/// the gate is still being calibrated, so its accuracy can be measured against
/// human decisions before it is trusted.
model CreativeEnrollmentReview {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeConfigId String              @db.Uuid
  storeConfig   CreativeStoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
  creativeId    String              @db.Uuid
  creative      Creative            @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  /// The analysis of the creative under review.
  runId         String?             @db.Uuid
  run           CreativeAiRun?      @relation("CreativeEnrollmentReviewRun", fields: [runId], references: [id], onDelete: SetNull)

  status          CreativeEnrollmentReviewStatus @default(QUEUED)
  decision        CreativeEnrollmentDecision?
  /// 0-100. Low confidence should route to a person even when the gate is
  /// otherwise trusted.
  confidence      Int?
  /// The gate's reasoning, each point citing a knowledge entry or a timestamp.
  rationale       Json?
  /// What to change, when the decision is REVISE.
  requiredChanges Json?

  /// True while the gate is being calibrated: it records what it would have
  /// decided and changes nothing.
  shadow     Boolean  @default(true)
  /// Which knowledge entries informed this decision, for audit.
  entryIds   String[] @default([]) @db.Uuid
  /// How many entries existed for the store at decision time. A decision made
  /// against a thin corpus deserves less weight, and this records that.
  corpusSize Int      @default(0)

  outcome       CreativeEnrollmentReviewOutcome @default(PENDING)
  decidedById   String?                         @db.Uuid
  decidedBy     User?                           @relation("CreativeEnrollmentReviewDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNotes String?

  knowledgeEntryId String?                 @db.Uuid
  knowledgeEntry   CreativeKnowledgeEntry? @relation(fields: [knowledgeEntryId], references: [id], onDelete: SetNull)

  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, storeConfigId, createdAt])
  @@index([tenantId, creativeId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, outcome, createdAt])
  @@map("creative_enrollment_reviews")
}

/// Where a store's creatives are launched: the ad account, the brand's page and
/// Instagram account, the budget a test starts at. Set once per store. The draft
/// worker refuses to run while any of it is missing, and names the gap.
model CreativeStorePublishingProfile {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeConfigId String              @unique @db.Uuid
  storeConfig   CreativeStoreConfig @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)

  /// Meta's account_id without the act_ prefix; one of the tenant's connected ad accounts.
  metaAdAccountId    String?
  facebookPageId     String?
  facebookPageName   String?
  instagramAccountId String?
  instagramUsername  String?
  /// The daily campaign budget a test starts at, in the ad account's currency.
  defaultDailyBudget Decimal? @db.Decimal(12, 2)
  /// ISO country codes the ad set targets. The SOP says the Philippines.
  countries          String[] @default(["PH"])
  /// Where "tomorrow, midnight" is measured for the start time.
  timezone           String   @default("Asia/Manila")

  updatedById String? @db.Uuid
  updatedBy   User?   @relation("CreativeStorePublishingProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products CreativeStoreProductDestination[]

  @@index([tenantId])
  @@map("creative_store_publishing_profiles")
}

/// One product's pixel and landing page. The SOP is explicit that a product
/// must optimise on its own pixel, so this is per product, matched on
/// Creative.posCustomId.
model CreativeStoreProductDestination {
  id        String                         @id @default(uuid()) @db.Uuid
  tenantId  String                         @db.Uuid
  tenant    Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profileId String                         @db.Uuid
  profile   CreativeStorePublishingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  posCustomId    String
  posProductName String?
  pixelId        String
  landingPageUrl String
  displayLink    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([profileId, posCustomId])
  @@index([tenantId])
  @@map("creative_store_product_destinations")
}

enum CreativeMetaDraftStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// One campaign with one ad set and one to three ads, created paused in Meta.
/// Every Meta id is written the moment it exists, so a retry resumes where the
/// last attempt stopped instead of creating a second campaign.
model CreativeMetaDraftBatch {
  id            String                  @id @default(uuid()) @db.Uuid
  tenantId      String                  @db.Uuid
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeConfigId String                  @db.Uuid
  storeConfig   CreativeStoreConfig     @relation(fields: [storeConfigId], references: [id], onDelete: Cascade)
  status        CreativeMetaDraftStatus @default(QUEUED)

  metaAdAccountId    String
  currency           String?
  campaignName       String
  adSetName          String
  dailyBudget        Decimal  @db.Decimal(12, 2)
  startTime          DateTime
  pixelId            String
  landingPageUrl     String
  displayLink        String?
  facebookPageId     String
  instagramAccountId String?
  countries          String[] @default(["PH"])
  /// The settings the SOP fixes, frozen at send time so a later reader sees what went out.
  settingsSnapshot   Json?

  metaCampaignId String?
  metaAdSetId    String?
  errorMessage   String?
  attempts       Int     @default(0)
  queueJobId     String?

  requestedById String? @db.Uuid
  requestedBy   User?   @relation("CreativeMetaDraftBatchRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  drafts CreativeMetaDraft[]

  @@index([tenantId, storeConfigId, createdAt])
  @@index([tenantId, status])
  @@map("creative_meta_draft_batches")
}

/// One ad in a batch: the creative's media in Meta, then the ad creative, then the ad.
model CreativeMetaDraft {
  id         String                  @id @default(uuid()) @db.Uuid
  tenantId   String                  @db.Uuid
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchId    String                  @db.Uuid
  batch      CreativeMetaDraftBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  creativeId String                  @db.Uuid
  creative   Creative                @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  status     CreativeMetaDraftStatus @default(QUEUED)

  /// Registry code first, then the maker's name, so the ad links back to its row.
  adName      String
  primaryText String?
  headline    String?

  metaVideoId       String?
  metaImageHash     String?
  metaThumbnailHash String?
  metaCreativeId    String?
  metaAdId          String?

  errorMessage    String?
  attempts        Int       @default(0)
  mediaUploadedAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([batchId, creativeId])
  @@index([tenantId, creativeId, createdAt])
  @@map("creative_meta_drafts")
}

// ============================================================================
// POS ORDER MODEL (Tenant-scoped)
// ============================================================================
model PosOrder {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamId   String? @db.Uuid
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  shopId     String
  posOrderId String // Order ID from POS system

  // Timestamps
  insertedAt      DateTime // UTC timestamp from POS
  dateLocal       String // Manila-local date (YYYY-MM-DD)
  deliveredAt     DateTime?
  rtsAt           DateTime?
  undeliverableAt DateTime?

  // Order details
  status                         Int?
  statusName                     String?
  cod                            Decimal?  @db.Decimal(12, 2)
  salesCod                       Decimal?  @db.Decimal(12, 2)
  mktgCod                        Decimal?  @db.Decimal(12, 2)
  isMarketingSource              Boolean   @default(false)
  forUpsell                      Boolean   @default(false)
  isRiskConfirmation             Boolean   @default(false)
  isAbandoned                    Boolean   @default(false)
  wasAbandonedCart               Boolean   @default(false)
  isRepurchase                   Boolean   @default(false)
  isUndeliverable                Boolean   @default(false)
  isVoid                         Boolean   @default(false)
  confirmationUpdateRequestedAt  DateTime?
  confirmationUpdateTargetStatus Int?
  reportsByPhoneOrderFail        Int?
  reportsByPhoneOrderSuccess     Int?
  reportsByPhoneWarning          Int?
  // UTM tracking
  pUtmCampaign                   String?
  pUtmContent                    String?

  // COGS calculation (from note_product)
  cogs          Decimal @default(0) @db.Decimal(12, 2)
  totalQuantity Int     @default(0)

  // Product info (from first item)
  tracking String?

  // Mapping (extracted from note_product, e.g., "Agriblast-100" → "Agriblast")
  mapping String?

  // Assignment info
  customerCare              String?
  marketer                  String?
  salesAssignee             String?
  assigningCare             String?
  customerName              String?
  customerPhone             String?
  customerAddress           String?
  deliveryAttemptFailed     Int                        @default(0)
  statusHistory             Json?
  trackingUpdates           Json?
  rtsReason                 Json?
  upsellBreakdown           Json?
  orderSnapshot             Json?
  // Order items snapshot (subset of fields)
  itemData                  Json                       @default("[]")
  tags                      Json                       @default("[]")
  wmsFulfillmentOrders      WmsFulfillmentOrder[]
  undeliverableAttempts     UndeliverableAttempt[]
  undeliverableOrderRemarks UndeliverableOrderRemark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, shopId, posOrderId])
  @@index([shopId, posOrderId], map: "pos_orders_shop_order_owner_idx")
  @@index([tenantId, shopId, dateLocal])
  @@index([tenantId, shopId, status, isVoid, insertedAt], map: "pos_orders_wms_pick_sync_idx")
  @@index([tenantId, teamId, dateLocal])
  @@index([tenantId, status, dateLocal, confirmationUpdateRequestedAt], map: "pos_orders_confirmation_queue_idx")
  @@index([tenantId, teamId, dateLocal, isRiskConfirmation], map: "pos_orders_tenant_team_date_risk_confirmation_idx")
  @@index([tenantId, dateLocal, isVoid], map: "pos_orders_tenant_date_void_idx")
  @@index([tenantId, isUndeliverable, undeliverableAt, shopId], map: "pos_orders_tenant_undeliverable_at_shop_idx")
  @@index([dateLocal])
  @@index([mapping])
  @@map("pos_orders")
}

