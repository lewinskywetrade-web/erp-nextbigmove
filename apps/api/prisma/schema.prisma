generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TENANT MODEL (Global - No tenantId)
// ============================================================================
model Tenant {
  id     String       @id @default(uuid()) @db.Uuid
  name   String
  slug   String       @unique
  domain String?      @unique
  status TenantStatus @default(ACTIVE)

  // Settings
  settings Json     @default("{}")
  metadata Json     @default("{}")
  features String[] @default([])

  // Limits
  maxUsers        Int @default(10)
  maxIntegrations Int @default(5)

  // Encryption
  encryptionKey String // Per-tenant encryption key

  // Billing
  planType               String    @default("trial")
  billingEmail           String?
  billingCompanyName     String?
  billingAddress         String?
  wmsFulfillmentGoLiveAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                               User[]
  memberships                         TenantMembership[]
  creativeFieldOptions                CreativeFieldOption[]
  integrations                        Integration[]
  analyticsEvents                     AnalyticsEvent[]
  pancakeWebhookLogs                  PancakeWebhookLog[]
  auditLogs                           AuditLog[]
  posStores                           PosStore[]
  posShopOwnerships                   PosShopOwnership[]
  metaAdAccounts                      MetaAdAccount[]
  posProductCogs                      PosProductCogs[]
  workflows                           Workflow[]
  workflowExecutions                  WorkflowExecution[]
  workflowExecutionLogs               WorkflowExecutionLog[]
  metaAdInsights                      MetaAdInsight[]
  posOrders                           PosOrder[]
  undeliverableAttempts               UndeliverableAttempt[]
  undeliverableAttemptProofs          UndeliverableAttemptProof[]
  undeliverableStoreAssignments       UndeliverableStoreAssignment[]
  undeliverableOrderRemarks           UndeliverableOrderRemark[]
  undeliverableRemarkOptions          UndeliverableRemarkOption[]
  posTags                             PosTag[]
  marketingKpiTargets                 MarketingKpiTarget[]
  marketingKpiUserCategoryAssignments MarketingKpiUserCategoryAssignment[]
  wmsProductProfiles                  WmsProductProfile[]
  mediaAssets                         MediaAsset[]
  wmsInvoiceSettings                  WmsInvoiceSettings?
  wmsInvoices                         WmsInvoice[]
  wmsInvoiceLines                     WmsInvoiceLine[]
  wmsPurchasingBatches                WmsPurchasingBatch[]
  wmsPurchasingBatchLines             WmsPurchasingBatchLine[]
  wmsPurchasingEvents                 WmsPurchasingEvent[]
  wmsReceivingBatches                 WmsReceivingBatch[]
  wmsReceivingLines                   WmsReceivingLine[]
  wmsInventoryUnits                   WmsInventoryUnit[]
  wmsFulfillmentOrders                WmsFulfillmentOrder[]
  wmsFulfillmentLines                 WmsFulfillmentLine[]
  wmsBaskets                          WmsBasket[]
  wmsPickReservations                 WmsPickReservation[]
  wmsBasketPickDemands                WmsBasketPickDemand[]
  wmsBasketPickDemandBins             WmsBasketPickDemandBin[]
  wmsBasketUnits                      WmsBasketUnit[]
  wmsTransfers                        WmsTransfer[]
  wmsInventoryMovements               WmsInventoryMovement[]
  wmsOutboundUnitRecords              WmsOutboundUnitRecord[]
  wmsLabelPrintLogs                   WmsLabelPrintLog[]
  wmsStaffActivities                  WmsStaffActivity[]
  wmsInventoryCountSessions           WmsInventoryCountSession[]
  wmsForecastSnapshots                WmsForecastSnapshot[]
  wmsForecastSnapshotRows             WmsForecastSnapshotRow[]
  notificationStates                  NotificationState[]
  reconcileMarketing                  ReconcileMarketing[]
  reconcileSales                      ReconcileSales[]
  reconcileSalesAttributions          ReconcileSalesAttribution[]
  analyticsShares                     AnalyticsShare[]
  teams                               Team[]
  teamMemberships                     TeamMembership[]
  roles                               Role[]
  userRoleAssignments                 UserRoleAssignment[]
  userPermissionAssignments           UserPermissionAssignment[]
  creativeStoreConfigs                CreativeStoreConfig[]
  creatives                           Creative[]
  creativeAliases                     CreativeAlias[]
  creativeStatusEvents                CreativeStatusEvent[]
  creativeInsightRuns                 CreativeInsightRun[]
  creativeStrategyEntries             CreativeStrategyEntry[]
  aiSetting                           AiSetting?
  creativeMetaAdLinks                 CreativeMetaAdLink[]
  creativeReviewComments              CreativeReviewComment[]
  creativeAiRuns                      CreativeAiRun[]
  creativeKnowledgeEntries            CreativeKnowledgeEntry[]
  creativeAiPromptTemplates           CreativeAiPromptTemplate[]
  creativeAiReferenceDocuments        CreativeAiReferenceDocument[]
  creativeAiRunFrames                 CreativeAiRunFrame[]
  creativeStoreTargets                CreativeStoreTarget[]
  creativeAiTargetDefault             CreativeAiTargetDefault?
  creativeEnrollmentReviews           CreativeEnrollmentReview[]
  creativeAiPolicy                    CreativeAiPolicy?
  creativeStorePublishingProfiles     CreativeStorePublishingProfile[]
  creativeStoreProductDestinations    CreativeStoreProductDestination[]
  creativeMetaDraftBatches            CreativeMetaDraftBatch[]
  creativeMetaDrafts                  CreativeMetaDraft[]
  metaAdInsightDuplicateArchives      MetaAdInsightDuplicateArchive[]
  wmsFulfillmentAmendments            WmsFulfillmentAmendment[]
  wmsFulfillmentAdjustments           WmsFulfillmentAdjustment[]
  adBenchmarks                        AdBenchmark[]
  adStrategyEntries                   AdStrategyEntry[]
  adLibraryEntries                    AdLibraryEntry[]
  adCreatives                         AdCreative[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
}

// ============================================================================
// TEAM MODEL (Tenant-scoped)
// ============================================================================
model Team {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  teamCode    String?
  description String?
  status      TeamStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  members                   TeamMembership[]
  integrations              Integration[]
  workflows                 Workflow[]
  workflowExecutions        WorkflowExecution[]
  posStores                 PosStore[]
  posProductCogs            PosProductCogs[]
  metaAdAccounts            MetaAdAccount[]
  metaAdInsights            MetaAdInsight[]
  posOrders                 PosOrder[]
  posTags                   PosTag[]
  reconcileMarketing        ReconcileMarketing[]
  reconcileSales            ReconcileSales[]
  userRoleAssignments       UserRoleAssignment[]
  userPermissionAssignments UserPermissionAssignment[]
  defaultUsers              User[]                     @relation("UserDefaultTeam")
  workflowExecutionLogs     WorkflowExecutionLog[]     @relation("TeamWorkflowExecutionLog")

  // Sharing back-relations
  sharedIntegrationLinks IntegrationSharedTeam[]
  sharedWorkflowLinks    WorkflowSharedTeam[]
  analyticsSharesOwned   AnalyticsShare[]        @relation("AnalyticsShareOwner")
  analyticsSharesShared  AnalyticsShare[]        @relation("AnalyticsShareTarget")
  adBenchmarks           AdBenchmark[]
  adStrategyEntries      AdStrategyEntry[]
  adLibraryEntries       AdLibraryEntry[]

  @@unique([tenantId, teamCode])
  @@index([tenantId])
  @@map("teams")
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

model TeamMembership {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamId    String               @db.Uuid
  team      Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String               @db.Uuid
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String?              @db.Uuid
  role      Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isDefault Boolean              @default(false)
  status    TeamMembershipStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([tenantId, userId, teamId])
  @@index([tenantId])
  @@index([roleId])
  @@map("team_memberships")
}

enum TeamMembershipStatus {
  ACTIVE
  INACTIVE
}

// ============================================================================
// RBAC MODELS (dynamic roles/permissions, tenant/team scoped)
// ============================================================================
enum RoleScope {
  GLOBAL
  TENANT
  TEAM
}

enum RbacWorkspace {
  ERP
  WMS
}

enum NotificationSystem {
  ERP
  WMS
}

enum NotificationDomain {
  PURCHASING
  ORDERS_AGING
  TRANSFER
  PICK_PACK
}

model Role {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String?       @db.Uuid
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  name        String
  description String?
  scope       RoleScope     @default(TENANT)
  workspace   RbacWorkspace @default(ERP)
  isSystem    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]
  teamMemberships TeamMembership[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([workspace])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userAssignments UserPermissionAssignment[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String        @db.Uuid
  role      Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  workspace RbacWorkspace
  tenantId  String?       @db.Uuid
  tenant    Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamId    String?       @db.Uuid
  team      Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, roleId, tenantId, teamId])
  @@index([tenantId])
  @@index([teamId])
  @@index([userId])
  @@index([roleId])
  @@index([workspace])
  @@map("user_roles")
}

model UserPermissionAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allow        Boolean    @default(true)
  tenantId     String?    @db.Uuid
  tenant       Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamId       String?    @db.Uuid
  team         Team?      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId, tenantId, teamId])
  @@index([tenantId])
  @@index([teamId])
  @@index([userId])
  @@index([permissionId])
  @@map("user_permissions")
}

// ============================================================================
// USER MODEL (Tenant-scoped)
// ============================================================================
model User {
  id                String  @id @default(uuid()) @db.Uuid
  email             String
  password          String
  firstName         String?
  lastName          String?
  avatar            String?
  employeeId        String?
  wmsBasketCapacity Int     @default(4)

  // Tenant (Row-level isolation) - Optional for SUPER_ADMIN
  tenantId          String?            @db.Uuid
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Every tenant this identity may work in. tenantId above is the LAST ACTIVE
  // one — the token decides which is active per session.
  tenantMemberships TenantMembership[]

  // RBAC (legacy enums remain for platform-level roles; dynamic roles use join tables)
  role          UserRole @default(USER)
  permissions   String[] @default([])
  defaultTeamId String?  @db.Uuid
  defaultTeam   Team?    @relation("UserDefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)

  // Status
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)

  // Timestamps
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  auditLogs                                 AuditLog[]
  teamMemberships                           TeamMembership[]
  userRoleAssignments                       UserRoleAssignment[]
  userPermissionAssignments                 UserPermissionAssignment[]
  wmsStaffAssignment                        WmsStaffAssignment?            @relation("WmsStaffAssignmentUser")
  wmsPurchasingBatchesCreated               WmsPurchasingBatch[]           @relation("WmsPurchasingBatchCreatedBy")
  wmsPurchasingBatchesSubmitted             WmsPurchasingBatch[]           @relation("WmsPurchasingBatchSubmittedBy")
  wmsPurchasingBatchesReviewed              WmsPurchasingBatch[]           @relation("WmsPurchasingBatchReviewedBy")
  wmsPurchasingBatchesApproved              WmsPurchasingBatch[]           @relation("WmsPurchasingBatchApprovedBy")
  wmsPurchasingBatchesPaymentProofSubmitted WmsPurchasingBatch[]           @relation("WmsPurchasingBatchPaymentProofSubmittedBy")
  wmsPurchasingBatchesUpdated               WmsPurchasingBatch[]           @relation("WmsPurchasingBatchUpdatedBy")
  wmsPurchasingBatchLinesCreated            WmsPurchasingBatchLine[]       @relation("WmsPurchasingBatchLineCreatedBy")
  wmsPurchasingBatchLinesUpdated            WmsPurchasingBatchLine[]       @relation("WmsPurchasingBatchLineUpdatedBy")
  mediaAssetsCreated                        MediaAsset[]                   @relation("MediaAssetCreatedBy")
  undeliverableAttemptProofsUploaded        UndeliverableAttemptProof[]    @relation("UndeliverableAttemptProofUploadedBy")
  wmsPackingProofsUploaded                  WmsPackingProof[]              @relation("WmsPackingProofUploadedBy")
  wmsInvoiceSettingsCreated                 WmsInvoiceSettings[]           @relation("WmsInvoiceSettingsCreatedBy")
  wmsInvoiceSettingsUpdated                 WmsInvoiceSettings[]           @relation("WmsInvoiceSettingsUpdatedBy")
  wmsInvoicesCreated                        WmsInvoice[]                   @relation("WmsInvoiceCreatedBy")
  wmsInvoicesUpdated                        WmsInvoice[]                   @relation("WmsInvoiceUpdatedBy")
  wmsStoxAppReleasesCreated                 WmsStoxAppRelease[]            @relation("WmsStoxAppReleaseCreatedBy")
  wmsStoxAppReleasesActivated               WmsStoxAppRelease[]            @relation("WmsStoxAppReleaseActivatedBy")
  wmsPurchasingEvents                       WmsPurchasingEvent[]           @relation("WmsPurchasingEventActor")
  wmsReceivingBatchesCreated                WmsReceivingBatch[]            @relation("WmsReceivingBatchCreatedBy")
  wmsReceivingBatchesUpdated                WmsReceivingBatch[]            @relation("WmsReceivingBatchUpdatedBy")
  wmsReceivingLinesCreated                  WmsReceivingLine[]             @relation("WmsReceivingLineCreatedBy")
  wmsReceivingLinesUpdated                  WmsReceivingLine[]             @relation("WmsReceivingLineUpdatedBy")
  wmsInventoryUnitsCreated                  WmsInventoryUnit[]             @relation("WmsInventoryUnitCreatedBy")
  wmsInventoryUnitsUpdated                  WmsInventoryUnit[]             @relation("WmsInventoryUnitUpdatedBy")
  wmsInventoryCountSessionsStarted          WmsInventoryCountSession[]     @relation("WmsInventoryCountSessionStartedBy")
  wmsInventoryCountSessionsSubmitted        WmsInventoryCountSession[]     @relation("WmsInventoryCountSessionSubmittedBy")
  wmsInventoryCountSessionsClosed           WmsInventoryCountSession[]     @relation("WmsInventoryCountSessionClosedBy")
  wmsTransfersCreated                       WmsTransfer[]                  @relation("WmsTransferCreatedBy")
  wmsTransfersUpdated                       WmsTransfer[]                  @relation("WmsTransferUpdatedBy")
  wmsInventoryMovements                     WmsInventoryMovement[]         @relation("WmsInventoryMovementActor")
  wmsLabelPrintLogs                         WmsLabelPrintLog[]             @relation("WmsLabelPrintLogActor")
  wmsStaffActivities                        WmsStaffActivity[]             @relation("WmsStaffActivityActor")
  wmsFulfillmentOrdersClaimed               WmsFulfillmentOrder[]          @relation("WmsFulfillmentOrderClaimedBy")
  wmsFulfillmentOrdersPacked                WmsFulfillmentOrder[]          @relation("WmsFulfillmentOrderPackedBy")
  wmsFulfillmentOrdersRtsDisposed           WmsFulfillmentOrder[]          @relation("WmsFulfillmentOrderRtsDisposedBy")
  wmsFulfillmentAdjustmentsCreated          WmsFulfillmentAdjustment[]     @relation("WmsFulfillmentAdjustmentCreatedBy")
  wmsBasketsAssigned                        WmsBasket[]                    @relation("WmsBasketAssignedPicker")
  wmsBasketsAssignedForPacking              WmsBasket[]                    @relation("WmsBasketAssignedPacker")
  wmsPickReservationsReserved               WmsPickReservation[]           @relation("WmsPickReservationReservedBy")
  wmsPickReservationsPicked                 WmsPickReservation[]           @relation("WmsPickReservationPickedBy")
  wmsBasketUnitsPicked                      WmsBasketUnit[]                @relation("WmsBasketUnitPickedBy")
  wmsBasketUnitsPacked                      WmsBasketUnit[]                @relation("WmsBasketUnitPackedBy")
  wmsBasketUnitsRemoved                     WmsBasketUnit[]                @relation("WmsBasketUnitRemovedBy")
  wmsForecastSnapshotsGenerated             WmsForecastSnapshot[]          @relation("WmsForecastSnapshotGeneratedBy")
  wmsStaffAssignmentsManaged                WmsStaffAssignment[]           @relation("WmsStaffAssignmentAssignedBy")
  readNotificationStates                    NotificationState[]            @relation("NotificationStateReadBy")
  undeliverableStoreAssignments             UndeliverableStoreAssignment[]
  creativesCreated                          Creative[]                     @relation("CreativeCreatedBy")
  creativeStrategyEntries                   CreativeStrategyEntry[]        @relation("CreativeStrategyAuthor")
  creativeAliasesCreated                    CreativeAlias[]                @relation("CreativeAliasCreatedBy")
  creativeStatusEvents                      CreativeStatusEvent[]          @relation("CreativeStatusEventActor")
  creativeMetaLinksCreated                  Creative[]                     @relation("CreativeMetaLinkedBy")
  creativeReviewComments                    CreativeReviewComment[]        @relation("CreativeReviewCommentAuthor")
  adStrategyEntries                         AdStrategyEntry[]              @relation("AdStrategyEntryCreatedBy")
  adLibraryEntries                          AdLibraryEntry[]               @relation("AdLibraryEntryCreatedBy")
  creativeAiRunsRequested                   CreativeAiRun[]                @relation("CreativeAiRunRequestedBy")
  creativeKnowledgePromoted                 CreativeKnowledgeEntry[]       @relation("CreativeKnowledgePromotedBy")
  creativeAiPromptTemplatesCreated          CreativeAiPromptTemplate[]     @relation("CreativeAiPromptTemplateCreatedBy")
  creativeAiReferenceDocumentsUploaded      CreativeAiReferenceDocument[]  @relation("CreativeAiReferenceDocumentUploadedBy")
  creativeStoreTargetsUpdated               CreativeStoreTarget[]          @relation("CreativeStoreTargetUpdatedBy")
  creativeAiTargetDefaultsUpdated           CreativeAiTargetDefault[]      @relation("CreativeAiTargetDefaultUpdatedBy")
  creativeEnrollmentReviewsDecided          CreativeEnrollmentReview[]     @relation("CreativeEnrollmentReviewDecidedBy")
  creativeAiPoliciesUpdated                 CreativeAiPolicy[]             @relation("CreativeAiPolicyUpdatedBy")
  creativeStorePublishingProfilesUpdated    CreativeStorePublishingProfile[] @relation("CreativeStorePublishingProfileUpdatedBy")
  creativeMetaDraftBatchesRequested         CreativeMetaDraftBatch[]       @relation("CreativeMetaDraftBatchRequestedBy")

  @@unique([email, tenantId])
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([email])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

// ============================================================================
// INTEGRATION MODEL (Tenant-scoped)
// ============================================================================
model Integration {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  provider    String
  description String?

  // Tenant (Row-level isolation)
  tenantId String  @db.Uuid
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamId   String? @db.Uuid
  team     Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Config
  config      Json   @default("{}")
  credentials String // Encrypted credentials

  // Status
  status  IntegrationStatus @default(PENDING)
  enabled Boolean           @default(false)

  // Sync
  lastSyncAt DateTime?
  syncStatus String?
  syncError  String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // POS store linkage (optional for PANCAKE_POS)
  posStores PosStore[]

  // Meta ad accounts linkage (optional for META_ADS)
  metaAdAccounts MetaAdAccount[]

  // Shared access
  sharedTeams IntegrationSharedTeam[]

  @@index([tenantId])
  @@index([tenantId, teamId])
  @@index([provider])
  @@index([tenantId, status])
  @@map("integrations")
}

model IntegrationSharedTeam {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @db.Uuid
  teamId        String   @db.Uuid
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([integrationId, teamId])
  @@index([teamId])
  @@map("integration_shared_teams")
}

model AnalyticsShare {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @db.Uuid
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerTeamId  String              @db.Uuid
  ownerTeam    Team                @relation("AnalyticsShareOwner", fields: [ownerTeamId], references: [id], onDelete: Cascade)
  targetTeamId String              @db.Uuid
  targetTeam   Team                @relation("AnalyticsShareTarget", fields: [targetTeamId], references: [id], onDelete: Cascade)
  scope        AnalyticsShareScope
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, ownerTeamId, targetTeamId, scope])
  @@index([tenantId, targetTeamId])
  @@index([tenantId, ownerTeamId])
  @@index([tenantId, scope])
  @@map("analytics_shares")
}

model PosStore {
  id                            String                         @id @default(uuid()) @db.Uuid
  tenantId                      String                         @db.Uuid
  tenant                        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teamId                        String?                        @db.Uuid
  team                          Team?                          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  integrationId                 String?                        @db.Uuid
  integration                   Integration?                   @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  name                          String
  shopId                        String
  shopName                      String
  shopAvatarUrl                 String?
  apiKey                        String
  description                   String?
  status                        IntegrationStatus              @default(ACTIVE)
  enabled                       Boolean?
  lastSyncAt                    DateTime?
  initialValueOffer             Decimal?                       @db.Decimal(12, 2)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  products                      PosProduct[]
  productCogs                   PosProductCogs[]
  tags                          PosTag[]
  warehouses                    PosWarehouse[]
  wmsPurchasingBatches          WmsPurchasingBatch[]
  wmsPurchasingBatchLines       WmsPurchasingBatchLine[]
  wmsReceivingBatches           WmsReceivingBatch[]
  wmsReceivingLines             WmsReceivingLine[]
  wmsProductProfiles            WmsProductProfile[]
  wmsInventoryUnits             WmsInventoryUnit[]
  wmsOutboundUnitRecords        WmsOutboundUnitRecord[]
  wmsFulfillmentOrders          WmsFulfillmentOrder[]
  wmsBasketPickDemands          WmsBasketPickDemand[]
  wmsBasketUnits                WmsBasketUnit[]
  wmsInvoiceLines               WmsInvoiceLine[]
  wmsForecastSnapshotRows       WmsForecastSnapshotRow[]
  undeliverableAttempts         UndeliverableAttempt[]
  undeliverableStoreAssignments UndeliverableStoreAssignment[]
  undeliverableOrderRemarks     UndeliverableOrderRemark[]
  activeShopOwnership           PosShopOwnership?
  creativeStoreConfig           CreativeStoreConfig?

  @@index([tenantId])
  @@index([tenantId, teamId])
  @@index([integrationId])
  @@map("pos_stores")
}

// One authoritative tenant/store may ingest new orders for a Pancake shop.
// Historical orders remain under their original tenant and are routed there by order ID.
model PosShopOwnership {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @unique
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId     String   @unique @db.Uuid
  store       PosStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  activatedAt DateTime @default(now())
  reason      String?
  claimedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("pos_shop_ownerships")
}

model PosProduct {
  id                              String                   @id @default(uuid()) @db.Uuid
  storeId                         String                   @db.Uuid
  store                           PosStore                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId                       String
  variationId                     String?
  warehouseId                     String?
  productSnapshot                 Json?
  customId                        String?
  name                            String
  retailPrice                     Decimal?                 @db.Decimal(12, 2)
  mapping                         String?
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt
  cogsHistory                     PosProductCogs[]
  wmsProductProfile               WmsProductProfile?
  wmsPurchasingBatchLinesResolved WmsPurchasingBatchLine[] @relation("WmsPurchasingLineResolvedPosProduct")
  wmsReceivingLinesResolved       WmsReceivingLine[]       @relation("WmsReceivingLineResolvedPosProduct")
  wmsInventoryUnits               WmsInventoryUnit[]

